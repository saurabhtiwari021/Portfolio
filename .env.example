# Your GitHub username
NEXT_PUBLIC_GITHUB_USERNAME="saurabhtiwari021"

# Whether you're available for work
NEXT_PUBLIC_AVAILABLE_STATUS=true

# Base URL of your deployed app
# Example: "https://yourdomain.com"
NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# --- Optional: only needed for live GitHub stats in the Stats section ---
# GitHub Personal Access Token (read-only scopes are enough)
# Example: ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
GITHUB_TOKEN="your-github-access-token"

# --- Optional: only needed for the "Portfolio views" stat via Umami ---
# Leave both unset to skip loading Umami entirely.
NEXT_PUBLIC_UMAMI_WEBSITE_ID="your-umami-site-id"
UMAMI_API_KEY="your-umami-api-key"
